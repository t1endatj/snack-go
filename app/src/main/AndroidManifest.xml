<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnackGo">

        <!-- Splash Launcher Activity -->
        <activity
            android:name=".view.activity.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.activity.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.MainActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.ProductDetailActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.CheckoutActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.OrderSuccessActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.OrderDetailActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.ChangePasswordActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.AdminProductListActivity"
            android:exported="false" />

        <activity
            android:name=".view.activity.AdminProductFormActivity"
            android:exported="false" />

    </application>

</manifest>
