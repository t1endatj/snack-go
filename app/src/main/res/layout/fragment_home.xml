<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="128dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- vùng tiêu đề có nền chuyển màu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_header_gradient"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <!-- hàng đầu: lời chào bên trái, chuông và avatar bên phải -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/layoutGreetingHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/layoutTopIcons"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            style="@style/TextAppearance.SnackGo.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/label_greeting_placeholder"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvHeadline"
                            style="@style/TextAppearance.SnackGo.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/headline_home"
                            android:textSize="22sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutTopIcons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnBell"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/label_notifications"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_bell"
                                app:tint="@color/primary_ink" />

                        </androidx.cardview.widget.CardView>

                        <!-- khung avatar tròn nền sáng với bóng nhẹ -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardAvatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/ivAvatar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_person"
                                app:tint="@color/primary_ink" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </RelativeLayout>

                <!-- hàng tìm kiếm với card trắng và bóng nhẹ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSearch"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                app:tint="@color/hint_grey" />

                            <EditText
                                android:id="@+id/etSearch"
                                style="@style/TextAppearance.SnackGo.Body"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="@string/hint_search"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/primary_ink"
                                android:textColorHint="@color/hint_grey"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnFilter"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@null"
                        app:backgroundTint="@color/primary_ink"
                        app:elevation="2dp"
                        app:fabCustomSize="48dp"
                        app:maxImageSize="22dp"
                        app:srcCompat="@drawable/ic_filter"
                        app:tint="@color/surface" />

                </LinearLayout>

            </LinearLayout>

            <!-- chip danh mục có thể cuộn ngang -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.SnackGo.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checkable="true"
                        android:checked="true"
                        android:text="@string/category_all"
                        android:textColor="@color/surface"
                        app:chipBackgroundColor="@color/primary_ink"
                        app:chipCornerRadius="22dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSnack"
                        style="@style/Widget.SnackGo.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checkable="true"
                        android:checked="false"
                        android:text="@string/category_snack"
                        android:textColor="@color/primary_ink"
                        app:chipBackgroundColor="@color/surface"
                        app:chipCornerRadius="22dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDrink"
                        style="@style/Widget.SnackGo.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checkable="true"
                        android:checked="false"
                        android:text="@string/category_drink"
                        android:textColor="@color/primary_ink"
                        app:chipBackgroundColor="@color/surface"
                        app:chipCornerRadius="22dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCandy"
                        style="@style/Widget.SnackGo.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checkable="true"
                        android:checked="false"
                        android:text="@string/category_candy"
                        android:textColor="@color/primary_ink"
                        app:chipBackgroundColor="@color/surface"
                        app:chipCornerRadius="22dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFavorite"
                        style="@style/Widget.SnackGo.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:checkable="true"
                        android:checked="false"
                        android:text="@string/category_favorite"
                        android:textColor="@color/primary_ink"
                        app:chipBackgroundColor="@color/surface"
                        app:chipCornerRadius="22dp"
                        app:chipIcon="@drawable/ic_heart_filled"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/red"
                        app:chipStrokeWidth="0dp" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- tiêu đề khu vực sản phẩm -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.SnackGo.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_collection"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_logo"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/badge_super_hot"
                        android:textColor="@color/accent_orange"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSeeAll"
                    style="@style/TextAppearance.SnackGo.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:text="@string/label_see_all"
                    android:textColor="@color/accent_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- trạng thái không có kết quả -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_search" />

                <TextView
                    android:id="@+id/tvEmptyStateMessage"
                    style="@style/TextAppearance.SnackGo.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/msg_empty_search"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_clear_filter"
                    android:textColor="@color/accent_orange"
                    app:strokeColor="@color/accent_orange" />

            </LinearLayout>

            <!-- lưới sản phẩm gồm 2 cột -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="128dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressHome"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_orange"
        android:visibility="gone" />

    <!-- thanh giỏ hàng nổi phía trên thanh điều hướng -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMiniCart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/primary_ink"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnViewCart"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.linh.snackgo.view.widget.BlendImageView
                    android:id="@+id/ivMiniCartThumb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:blendCardBackgroundColor="@color/promo_input_bg"
                    app:blendCornerRadius="12dp"
                    app:blendPaddingRatio="0.08" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniCartCount"
                        style="@style/TextAppearance.SnackGo.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_ink_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMiniCartTotal"
                        style="@style/TextAppearance.SnackGo.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewCart"
                style="@style/Widget.SnackGo.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@color/accent_orange"
                android:paddingHorizontal="16dp"
                android:text="@string/label_view_cart"
                android:textColor="@color/surface"
                android:textSize="13sp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end"
                app:iconSize="16dp"
                app:iconTint="@color/surface" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
