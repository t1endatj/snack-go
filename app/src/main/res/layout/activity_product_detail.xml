<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- vùng hero đầu trang với nền chuyển màu theo danh mục -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_gradient_snack"
        app:layout_constraintHeight_percent="0.42"
        app:layout_constraintTop_toTopOf="parent">

        <!-- vùng sáng trắng nhẹ phía sau sản phẩm -->
        <View
            android:id="@+id/viewHeroGlow"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_illustration_glow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- thư viện ảnh sản phẩm bằng ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpProductImages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/layoutDotsContainer"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- các chấm chỉ báo ảnh hiện tại -->
        <LinearLayout
            android:id="@+id/layoutDotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/rvProductThumbnails"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- dải ảnh thu nhỏ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductThumbnails"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="30dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- thanh nút thao tác phía trên -->
        <RelativeLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/primary_ink" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/ivFavoriteIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_heart" />

                </com.google.android.material.card.MaterialCardView>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnCart"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="3dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_cart"
                            app:tint="@color/primary_ink" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvCartBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_cart_badge"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="18dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="@color/surface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- phần nội dung bo góc, chồng lên hero 24dp -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_top_corners_sheet"
        android:elevation="6dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar"
        app:layout_constraintTop_toBottomOf="@id/layoutHero">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- nhãn sản phẩm và danh mục -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTagBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_logo"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Bán chạy" />

                <TextView
                    android:id="@+id/tvCategory"
                    style="@style/TextAppearance.SnackGo.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    tools:text="Snack" />

            </LinearLayout>

            <!-- tên sản phẩm -->
            <TextView
                android:id="@+id/tvProductName"
                style="@style/TextAppearance.SnackGo.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/primary_ink"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Snack Khoai Tây Vị Phô Mai Lay's" />

            <!-- các chip thông tin theo chiều ngang -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- chip đánh giá và số sao -->
                    <LinearLayout
                        android:id="@+id/chipRating"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_detail_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_filled" />

                        <TextView
                            android:id="@+id/tvRatingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/primary_ink"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="4.8" />

                    </LinearLayout>

                    <!-- chip số lượng đã bán -->
                    <LinearLayout
                        android:id="@+id/chipSold"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_detail_chip"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSoldValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp"
                            tools:text="Đã bán 1.2k" />

                    </LinearLayout>

                    <!-- chip thời gian giao hàng 15 phút -->
                    <LinearLayout
                        android:id="@+id/chipDelivery"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_detail_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_delivery_fast"
                            app:tint="@color/primary_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/label_delivery_time_15m"
                            android:textColor="@color/primary_ink"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- chip kích thước hoặc quy cách -->
                    <LinearLayout
                        android:id="@+id/chipSize"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_detail_chip"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp"
                            tools:text="53g" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- dòng giá sản phẩm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProductPrice"
                    style="@style/TextAppearance.SnackGo.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="22.000đ" />

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    style="@style/TextAppearance.SnackGo.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="26.000đ" />

                <TextView
                    android:id="@+id/tvDiscountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_discount"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="-15%" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divider" />

            <!-- phần mô tả sản phẩm -->
            <TextView
                android:id="@+id/labelDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_product_description"
                android:textColor="@color/primary_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescription"
                style="@style/TextAppearance.SnackGo.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/primary_ink"
                android:textSize="13sp"
                tools:text="Toonies là dòng sản phẩm snack khoai tây thuộc thương hiệu nổi tiếng Orion của Hàn Quốc..." />

            <TextView
                android:id="@+id/tvDescToggle"
                style="@style/TextAppearance.SnackGo.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_see_more"
                android:textColor="@color/accent_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- card thông tin chi tiết -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProductSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/background"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_product_spec_title"
                        android:textColor="@color/primary_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutSpecsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- card cam kết từ SnackGo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCommitments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/background"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/label_commitment_title"
                        android:textColor="@color/primary_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- cam kết thứ nhất -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_delivery_fast"
                                app:tint="@color/accent_orange" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/commitment_fast_delivery"
                                android:textColor="@color/primary_ink"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- cam kết thứ hai -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_fresh" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/commitment_fresh_daily"
                                android:textColor="@color/primary_ink"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- cam kết thứ ba -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_return_easy" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/commitment_easy_return"
                                android:textColor="@color/primary_ink"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- phần sản phẩm bạn có thể thích -->
            <LinearLayout
                android:id="@+id/layoutRelatedProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/label_you_may_also_like"
                    android:textColor="@color/primary_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRelatedProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- thanh thao tác cố định phía dưới -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="10dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/bottomBarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- bộ điều chỉnh số lượng -->
        <LinearLayout
            android:id="@+id/layoutStepper"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_detail_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottomBarDivider">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_minus"
                app:iconSize="16dp"
                app:iconTint="@color/primary_ink" />

            <TextView
                android:id="@+id/tvQuantity"
                style="@style/TextAppearance.SnackGo.Title"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/default_quantity"
                android:textColor="@color/primary_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_plus"
                app:iconSize="16dp"
                app:iconTint="@color/primary_ink" />

        </LinearLayout>

        <!-- nút thêm vào giỏ dạng viền -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="@color/primary_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="23dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBuyNow"
            app:layout_constraintHorizontal_weight="1.15"
            app:layout_constraintStart_toEndOf="@id/layoutStepper"
            app:layout_constraintTop_toBottomOf="@id/bottomBarDivider"
            app:strokeColor="@color/primary_ink"
            app:strokeWidth="1.5dp"
            tools:text="Thêm • 22.000đ" />

        <!-- nút mua ngay dạng nền đặc -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyNow"
            style="@style/Widget.SnackGo.Button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/primary_ink"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/label_buy_now"
            android:textColor="@color/surface"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="23dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="0.85"
            app:layout_constraintStart_toEndOf="@id/btnAddToCart"
