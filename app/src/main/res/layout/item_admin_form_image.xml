<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAdminFormImage"
    android:layout_width="88dp"
    android:layout_height="88dp"
    android:layout_marginHorizontal="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.linh.snackgo.view.widget.BlendImageView
            android:id="@+id/ivFormThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:blendCardBackgroundColor="@color/promo_input_bg"
            app:blendCornerRadius="16dp"
            app:blendPaddingRatio="0.08" />

        <!-- Cover Badge -->
        <TextView
            android:id="@+id/tvCoverBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_chip_logo"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/label_cover_image"
            android:textColor="@color/accent_orange"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Make Cover Star Button -->
        <ImageView
            android:id="@+id/btnMakeCover"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_chip_logo"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/amber" />

        <!-- Remove (x) Button -->
        <ImageView
            android:id="@+id/btnRemoveFormImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_chip_logo"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_plus"
            android:rotation="45"
            app:tint="@color/red" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
