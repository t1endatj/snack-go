<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSpecLabel"
            style="@style/TextAppearance.SnackGo.Body"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSpecValue"
            style="@style/TextAppearance.SnackGo.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/primary_ink"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSpecToggle"
        style="@style/TextAppearance.SnackGo.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginTop="4dp"
        android:text="@string/label_see_more"
        android:textColor="@color/accent_orange"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:id="@+id/specDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider" />

</LinearLayout>
