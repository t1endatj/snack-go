<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOnboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_gradient">

    <!-- Top Right Skip Button (Pill shaped, semi-transparent white bg, dark text, small chevron) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkip"
        style="@style/Widget.Material3.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#4DFFFFFF"
        android:paddingHorizontal="14dp"
        android:paddingVertical="0dp"
        android:text="@string/label_skip"
        android:textColor="@color/primary_ink"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="19dp"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconPadding="4dp"
        app:iconSize="16dp"
        app:iconTint="@color/primary_ink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ViewPager for Illustrations (~42% screen height) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomSheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.42"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSkip" />

    <!-- White Rounded Sheet (top corners 32dp) extending to the very bottom edge -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_top_corners_sheet"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="26dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewPagerOnboarding">

        <TextView
            android:id="@+id/tvLogoChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_logo"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/app_name"
            android:textColor="@color/accent_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetTitle"
            style="@style/TextAppearance.SnackGo.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/onboarding_title_1"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvSheetDesc"
            style="@style/TextAppearance.SnackGo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:text="@string/onboarding_desc_1"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Animated Dots Indicator Container (8dp dots, active 24dp x 8dp orange pill, 6dp spacing) -->
        <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            style="@style/Widget.SnackGo.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/primary_ink"
            android:text="@string/label_next"
            android:textColor="@color/surface"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="12dp"
            app:iconTint="@color/surface" />

        <TextView
            android:id="@+id/tvCaption"
            style="@style/TextAppearance.SnackGo.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_onboarding_caption"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
